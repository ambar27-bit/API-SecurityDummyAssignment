# ============================================================
# DummyJSON API Security Test Framework - Environment Config
# ============================================================
# Copy this file to .env and fill in values before running tests.
# NEVER commit the .env file to source control.
# Credentials can be obtained from https://dummyjson.com/users
# ============================================================

# Base URL of the target API
BASE_URL=https://dummyjson.com

# Admin user credentials (role: admin)
# e.g. a user whose /users/{id} shows "role": "admin"
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Regular user credentials (role: user)
# Must be a DIFFERENT user from the admin
USER_USERNAME=
USER_PASSWORD=

# A second regular user (used for cross-user ownership tests)
# Must be a DIFFERENT user from USER_USERNAME
USER2_USERNAME=
USER2_PASSWORD=

# Token expiry in minutes (optional, defaults to 60)
TOKEN_EXPIRES_IN_MINS=60
